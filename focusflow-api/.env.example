PORT=3001
NODE_ENV=development
DATABASE_PATH=./focusflow.db

# Microsoft Entra ID — required for protected API routes
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
# Optional — defaults to api://{AZURE_CLIENT_ID}
AZURE_API_AUDIENCE=
# Optional — scope claim required on access tokens (default: access_as_user)
AZURE_REQUIRED_SCOPE=access_as_user
