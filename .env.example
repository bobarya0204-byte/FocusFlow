# FocusFlow environment template
# Copy to `.env` or `.env.local` for local overrides.
# Only VITE_* keys are exposed to the browser bundle.

VITE_APP_NAME=FocusFlow
VITE_APP_ENV=development

# Public base path for Vite / Azure Static Web Apps (usually "/")
VITE_BASE_PATH=/

# When true, attempt Microsoft Teams host detection at runtime.
# Browser mode still works if detection fails.
VITE_TEAMS_ENABLED=true

# Future Microsoft Entra ID / Teams SSO (leave empty for Phase 1)
VITE_AZURE_AD_CLIENT_ID=
VITE_AZURE_AD_TENANT_ID=
VITE_AZURE_AD_REDIRECT_URI=

# Future FocusFlow API / sync backend
VITE_API_BASE_URL=
